# --- Your domain --------------------------------------------------------------
DOMAIN=seatbell.example
BASE_URL=https://seatbell.example
CONTACT_EMAIL=you@asu.edu
APP_NAME=Seatbell

# --- Secrets: generate with `openssl rand -hex 32` -----------------------------
SESSION_SECRET=
POSTGRES_PASSWORD=
GRAFANA_PASSWORD=

# --- Email: resend.com, after verifying your domain ----------------------------
RESEND_API_KEY=
EMAIL_FROM=Seatbell <alerts@seatbell.example>
# Alert emails allowed per day (0 = no cap). Resend's free plan sends 100 a day,
# so 80 keeps room for sign-in codes. Raise or clear it if you upgrade.
EMAIL_ALERT_DAILY_BUDGET=80

# --- Push: generate with `npm run vapid` ---------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Who can sign up and which terms exist -------------------------------------
ALLOWED_EMAIL_DOMAINS=asu.edu
TERMS=2271:Spring 2027
WATCH_LIMIT=10

# --- Seat data ------------------------------------------------------------------
# Leave blank until you've done docs/DEPLOY.md step 1. Set it only to the value the
# public class search page sends while you are logged OUT. Never use a token from
# your own ASU session.
ASU_AUTHORIZATION=

# Kill switch. Set to false and restart the worker to stop all requests to ASU.
POLLING_ENABLED=true
# How often each course is checked, and the minimum gap between any two requests.
POLL_INTERVAL_MS=90000
POLL_MIN_SPACING_MS=2000
